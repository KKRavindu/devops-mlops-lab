{
  "uid": "wine-api",
  "title": "Wine API - Service & Model Health",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "Request rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(api_requests_total{path=\"/predict\"}[1m]))" }]
    },
    {
      "type": "stat", "title": "Error rate",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] } } },
      "targets": [{ "expr": "sum(rate(api_requests_total{path=\"/predict\",status=~\"5..\"}[1m])) / sum(rate(api_requests_total{path=\"/predict\"}[1m]))" }]
    },
    {
      "type": "stat", "title": "Mean confidence",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 0.6 } ] } } },
      "targets": [{ "expr": "sum(rate(model_prediction_confidence_sum[2m])) / sum(rate(model_prediction_confidence_count[2m]))" }]
    },
    {
      "type": "table", "title": "Loaded model",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "model_info", "format": "table", "instant": true }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true } } }]
    },
    {
      "type": "timeseries", "title": "Latency (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(api_request_latency_seconds_bucket{path=\"/predict\"}[1m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_latency_seconds_bucket{path=\"/predict\"}[1m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_latency_seconds_bucket{path=\"/predict\"}[1m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries", "title": "Requests by status",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum by (status) (rate(api_requests_total{path=\"/predict\"}[1m]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "Predictions by class (watch for skew)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "stacking": { "mode": "percent" }, "fillOpacity": 60 } } },
      "targets": [{ "expr": "sum by (class_name) (rate(model_predictions_total[1m]))", "legendFormat": "{{class_name}}" }]
    },
    {
      "type": "timeseries", "title": "Confidence over time",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "expr": "sum(rate(model_prediction_confidence_sum[1m])) / sum(rate(model_prediction_confidence_count[1m]))", "legendFormat": "mean confidence" }]
    }
  ]
}
